FROM oven/bun:1.3.13-alpine AS admin-build

WORKDIR /app

COPY package.json bun.lock tsconfig.base.json ./
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/server-admin/package.json apps/server-admin/package.json
COPY packages/cli/package.json packages/cli/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/manager-protocol/package.json packages/manager-protocol/package.json
COPY packages/server/package.json packages/server/package.json

RUN bun install --frozen-lockfile

COPY apps/server-admin apps/server-admin
COPY packages/server/src/admin-types.ts packages/server/src/admin-types.ts

RUN bun run --cwd apps/server-admin build

FROM oven/bun:1.3.13-alpine

WORKDIR /app

COPY package.json bun.lock ./
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/server-admin/package.json apps/server-admin/package.json
COPY packages/cli/package.json packages/cli/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/manager-protocol/package.json packages/manager-protocol/package.json
COPY packages/server/package.json packages/server/package.json

RUN bun install --frozen-lockfile --production --filter @reglet/server

COPY packages/core/src packages/core/src
COPY packages/manager-protocol/src packages/manager-protocol/src
COPY packages/server/src packages/server/src
COPY --from=admin-build /app/apps/server-admin/dist /app/admin

RUN mkdir -p /data /backups && chown -R bun:bun /app /data /backups

USER bun

ENV NODE_ENV=production \
    PORT=3000 \
    REGLET_DB=/data/reglet.sqlite \
    REGLET_ADMIN_ASSETS=/app/admin \
    REGLET_BACKUP_DIR=/backups \
    REGLET_ENABLE_LEGACY_V1=0 \
    REGLET_ALLOW_REGISTRATION=0 \
    REGLET_TRUST_PROXY=0

VOLUME ["/data", "/backups"]
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD bun -e "const response = await fetch('http://127.0.0.1:3000/readyz'); if (!response.ok) process.exit(1)"

CMD ["bun", "packages/server/src/index.ts"]
