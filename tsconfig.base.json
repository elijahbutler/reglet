{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@reglet/core": ["packages/core/src/index.ts"],
      "@reglet/manager-protocol": ["packages/manager-protocol/src/index.ts"]
    }
  }
}
